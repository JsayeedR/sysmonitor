# SysMonitor — new environment variables added for offsite remote backup.
#
# Copy the lines below into your REAL .env on the server (the one already
# containing DJANGO_SECRET_KEY / KUMA_*) and fill in your actual remote
# server details. Nothing here is a working credential — this file is just
# documentation and is safe to commit to git.
#
# HOW IT WORKS
# ------------
# - Requires the `rsync` package on this server: sudo apt install rsync
# - Uses SSH key auth only (no passwords). On THIS server, as the `nanolab`
#   user, generate a key if you don't already have one and copy it to the
#   remote server:
#       ssh-keygen -t ed25519 -f ~/.ssh/sysmonitor_backup
#       ssh-copy-id -i ~/.ssh/sysmonitor_backup.pub youruser@your-remote-host
# - Leave REMOTE_BACKUP_HOST blank/unset and remote sync is skipped
#   entirely — local backups still run as before.
#
# WHAT SYNCS WHEN
# ----------------
# - Once a day at 00:01 BDT (same time as the existing local backup):
#   the full database snapshot + a project code tarball — the "large data".
# - Every 5 minutes (new sysmonitor-realtime-sync.timer): just the live
#   db.sqlite3, so the offsite copy is never more than a few minutes stale.

REMOTE_BACKUP_HOST=backup.example.com
REMOTE_BACKUP_USER=youruser
REMOTE_BACKUP_PORT=22
REMOTE_BACKUP_PATH=/home/youruser/sysmonitor-backups
REMOTE_BACKUP_SSH_KEY=/home/nanolab/.ssh/sysmonitor_backup

# ── After adding these to your real .env, enable the new timer ─────────────
#   sudo cp systemd/sysmonitor-realtime-sync.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sysmonitor-realtime-sync.timer
#
# Test it manually first:
#   cd /home/nanolab/Desktop/sysmonitor
#   source venv/bin/activate
#   python monitor/realtime_sync.py
#   python monitor/backup.py     # also now pushes to remote if configured
