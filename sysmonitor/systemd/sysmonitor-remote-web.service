# REMOTE server only (app.bsccl.com). Runs the website copy.
# Do NOT install any other monitoring/notification sysmonitor-* service on the remote.
[Unit]
Description=SysMonitor remote website (gunicorn)
After=network.target

[Service]
Type=simple
User=app-admin
WorkingDirectory=/home/app-admin/sysmonitor-repo/sysmonitor
EnvironmentFile=/home/app-admin/sysmonitor-repo/sysmonitor/.env
ExecStart=/home/app-admin/sysmonitor-venv/bin/gunicorn sysmonitor.wsgi:application --bind 127.0.0.1:8020 --workers 2 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
