# Add these to the MASTER's .env  (the file in /home/nanolab/Desktop/sysmonitor)
MIRROR_HOST=app.bsccl.com
MIRROR_USER=app-admin
MIRROR_PORT=3048
MIRROR_PATH=/home/app-admin/sysmonitor/repo/sysmonitor
MIRROR_SSH_KEY=/home/nanolab/.ssh/sysmonitor_ed25519
# Same long random value on master and remote:
#   python3 -c "import secrets;print(secrets.token_urlsafe(40))"
MIRROR_SHARED_SECRET=<paste the secret>
# Code reaches the remote through GitHub (see MIRROR_SETUP.md part E):
MIRROR_CODE_SYNC=git
# Where users open the remote site (used in password-reset messages):
MIRROR_PUBLIC_URL=https://app.bsccl.com/sysmonitor
