# SysMonitor — new environment variables for the Tuya colocation sensor.
#
# Copy the lines below into your REAL .env on the server and fill in your
# actual values from the Tuya IoT Platform (Cloud → SysMonitor2 project).
# Nothing here is a working credential — safe to commit to git as-is.
#
# Get these from https://iot.tuya.com → Cloud → Development → SysMonitor2:
#   - TUYA_ACCESS_ID / TUYA_ACCESS_SECRET: project "Overview" tab
#   - TUYA_DEVICE_ID: project "Devices" tab, the linked T&H sensor's Device ID
#
# TUYA_API_BASE is already correct for your account (Bangladesh -> Central
# Europe Data Center, confirmed from Tuya's own mapping table) — no need
# to change it.

TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here
TUYA_DEVICE_ID=your_device_id_here
TUYA_API_BASE=https://openapi.tuyaeu.com

# ── After adding these to your real .env ────────────────────────────────────
#
# 1. Test it manually FIRST, before trusting the automatic timer:
#      cd /home/nanolab/Desktop/sysmonitor
#      source venv/bin/activate
#      python monitor/poll_tuya.py --debug
#
#    --debug prints the raw Tuya status payload. The first run matters:
#    it confirms the temperature/humidity status codes this specific
#    sensor reports match what the code expects. If it says "Connected
#    OK, but none of the known status codes matched", paste the raw
#    output back so the code list can be extended for this device.
#
# 2. Once that works, enable the 2-minute polling timer:
#      sudo cp systemd/sysmonitor-tuya-poll.service /etc/systemd/system/
#      sudo cp systemd/sysmonitor-tuya-poll.timer /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now sysmonitor-tuya-poll.timer
#
# 3. Confirm it's scheduled:
#      systemctl list-timers sysmonitor-tuya-poll.timer --no-pager
#
# 4. View the sensor page at /sensor/ once a couple of readings have
#    come in.
