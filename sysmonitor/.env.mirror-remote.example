# REMOTE server: /home/app-admin/sysmonitor-repo/sysmonitor/.env   (chmod 600)
# Use a NEW secret key here — do not copy the master's:
#   python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<paste a new random key>
DJANGO_ALLOWED_HOSTS=app.bsccl.com
SYSMONITOR_ROLE=remote
MIRROR_URL_PREFIX=/sysmonitor
MIRROR_HTTPS=1
MIRROR_TRUSTED_ORIGINS=https://app.bsccl.com
# Exactly the same value as on the master:
MIRROR_SHARED_SECRET=<same secret as the master>
# The master, reached through the SSH tunnel (do not change):
MIRROR_MASTER_URL=http://127.0.0.1:18000
MIRROR_PUBLIC_URL=https://app.bsccl.com/sysmonitor
# No KUMA_*, TUYA_* or notification settings are needed on the remote.
